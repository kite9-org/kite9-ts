{
  "name": "kite9-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter '!@kite9/layout' run build",
    "test": "pnpm -r --filter '!@kite9/layout' run test",
    "test:coverage": "pnpm -r --filter '!@kite9/layout' run test:coverage",
    "test:e2e": "pnpm --filter @kite9/ui-behaviours test:e2e",
    "test:report": "open packages/kite9-test-template/coverage/index.html",
    "typecheck": "pnpm -r --filter '!@kite9/layout' run typecheck",
    "start": "pnpm --filter @kite9/preview start",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "^3.0.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },

  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=20"
  }
}
