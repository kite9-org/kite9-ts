{
  "name": "@kite9/test-template",
  "version": "0.1.0",
  "description": "Test templates, chrome, grid layout, and fixture data for Kite9 scenes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/grid/card.json": "./fixtures/grid/card.json",
    "./fixtures/grid/empty.json": "./fixtures/grid/empty.json",
    "./e2e": "./fixtures/e2e/open-card-edit.ts",
    "./e2e/vite": "./fixtures/e2e/create-e2e-vite-config.ts"
  },
  "files": ["dist", "src", "fixtures", "README.md"],
  "scripts": {
    "build": "vite build && tsc -b --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kite9/command": "workspace:*",
    "@kite9/css": "workspace:*",
    "@kite9/model": "workspace:*",
    "@kite9/templating": "workspace:*",
    "@kite9/ui": "workspace:*",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitest/coverage-v8": "^3.0.5",
    "happy-dom": "^17.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "@playwright/test": "^1.51.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": { "optional": true }
  }
}
