{
  "name": "@kite9/ui",
  "version": "0.1.0",
  "description": "Behaviour contract and shared UI helpers for light/shadow diagram editing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kite9/command": "workspace:*",
    "@kite9/css": "workspace:*",
    "@kite9/model": "workspace:*"
  },

  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "happy-dom": "^17.1.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
